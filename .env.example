# AgentMonitor Environment Configuration
# Copy this file to .env and fill in the values

# ============ REQUIRED (production) ============

# JWT secret for authentication (MUST be 32+ characters in production)
JWT_SECRET=your-secure-random-secret-at-least-32-characters-long

# Comma-separated list of allowed origins (REQUIRED in production)
CORS_ORIGINS=https://your-domain.com

# ============ DATABASE ============

DB_TYPE=postgres
PG_USER=postgres
PG_PASSWORD=change-this-to-a-strong-password
PG_DATABASE=agentmonitor
PG_HOST=postgres
PG_PORT=5432
# Enable SSL for database connections in production (default: true in production)
# DB_SSL=true

# ============ JWT ============

# Access token expiration (default: 2h in production, 7d in development)
# JWT_ACCESS_EXPIRES_IN=2h
# Refresh token expiration (default: 30d)
# JWT_REFRESH_EXPIRES_IN=30d

# ============ SECURITY ============

# API Key expiration in days (default: 90)
# API_KEY_EXPIRATION_DAYS=90

# ============ OPTIONAL ============

# WebSocket max connections (default: 1000)
# WS_MAX_CONNECTIONS=1000
# WebSocket max connections per user (default: 10)
# WS_MAX_PER_USER=10

# Rate limiting - global (requests per minute)
# RATE_LIMIT_MAX=100

# Rate limiting - auth endpoints (requests per 15 minutes)
# RATE_LIMIT_AUTH_MAX=5

# API max limit for pagination (default: 1000)
# API_MAX_LIMIT=1000

# Database connection pool
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT=30000
