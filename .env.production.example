# =====================================================================
# AgentMonitor 生产环境配置模板（无域名 / 自签证书 / IP 访问场景）
#
# 用法：
#   1. cp .env.production.example .env
#   2. 按下述说明填写/生成强密钥（所有「修改我」必须替换）
#   3. 生成自签证书：bash scripts/ssl-setup.sh --self-signed
#      （脚本会自动探测本机 IP 写入证书 SAN；如有公网 IP 可追加 --ip <公网IP>）
#   4. 启动：docker compose up -d --build
#   5. 访问：https://<服务器IP>/  （浏览器首次会提示自签证书不受信任，手动信任即可）
#
# 注意：本文件可安全提交到版本库；真正的 .env 已被 .gitignore 忽略，切勿提交。
# =====================================================================

# ============ 必填：JWT 密钥（≥32 字符，生产必须重新生成）============
# 生成命令：openssl rand -hex 32
JWT_SECRET=修改我-用-openssl-rand-hex-32-生成的64位随机串

# ============ 必填：CORS 允许来源 ============
# 无域名、按 IP 访问时，填你访问前端用的地址（https + 服务器 IP）。
# 多个用逗号分隔。示例（把 203.0.113.5 换成你的服务器实际 IP）：
CORS_ORIGINS=https://203.0.113.5
# 如需同时允许局域网 IP，可追加：
# CORS_ORIGINS=https://203.0.113.5,https://192.168.1.10

# ============ 必填：PostgreSQL 数据库 ============
# 生产强密码（勿用 postgres 这类弱密码）。生成命令：openssl rand -base64 24
PG_USER=postgres
PG_PASSWORD=修改我-强数据库密码
PG_DATABASE=agentmonitor
PG_HOST=postgres
PG_PORT=5432

# 数据库 SSL：
# - 使用本仓库 docker-compose 自带的 PostgreSQL 容器时，容器内网通信无 TLS，
#   docker-compose.yml 已固定 DB_SSL=false，无需在此设置。
# - 若改用云端托管 PostgreSQL（带 TLS），请在 docker-compose 中删除 DB_SSL 覆盖，
#   并在此设置 DB_SSL=true。
# DB_SSL=false

# ============ 可选：限流（生产默认已开启，无需额外设置）============
# 全局每 IP 每分钟最大请求数（默认 100）。
# 注意：不要使用本地测试时的超大值（如 100000），否则限流形同虚设。
RATE_LIMIT_MAX=100
# 登录/注册等鉴权接口每 15 分钟最大尝试次数（默认 5，防暴力破解）
RATE_LIMIT_AUTH_MAX=5

# ============ 可选：数据库连接池 ============
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# ============ 可选：模型单价覆盖 ============
# 成本核算默认使用内置价格表；如需自定义/补充私有模型单价，可设置 JSON。
# 格式：{"模型名":{"input":每百万输入token美元单价,"output":每百万输出token美元单价}}
# （单价单位与内置表一致：美元 / 1K tokens）
# MODEL_PRICING_JSON={"my-private-model":{"input":0.002,"output":0.006}}

# ============ 可选：WebSocket 连接数 ============
# WS_MAX_CONNECTIONS=1000
# WS_MAX_PER_USER=10
