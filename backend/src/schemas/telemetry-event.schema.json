{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmonitor.local/schemas/telemetry-event.schema.json",
  "title": "TelemetryEvent",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "enum": [
        "session.start",
        "session.end",
        "trace.start",
        "trace.end",
        "span.start",
        "span.end",
        "feedback.created",
        "sample.completed"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "resource": {
      "type": "object",
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
