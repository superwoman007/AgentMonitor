{
  "name": "agentmonitor-root",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.12.2",
    "nock": "^14.0.13",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "test:e2e": "playwright test -c playwright.config.e2e.ts",
    "test:e2e:ui": "playwright test -c playwright.config.e2e.ts --ui",
    "test:e2e:report": "playwright show-report e2e-report",
    "test:agent": "vitest run tests/agent --config tests/agent/vitest.config.ts"
  }
}
